# =============================================================================
# resolverd — recursive/forwarding resolver + cache + DNSSEC validation
# (the recursive role; formerly dns_client.c). Distinct daemon from dnsd.
# -Wno-misleading-indentation: resolverd.c is clang-format-conformant but its
# dense one-statement-heavy style trips gcc's -Wmisleading-indentation heuristic;
# suppress just that one warning here (as the unit-test targets already do) to
# keep the -Werror build green. The rest of the curated WARN set still applies.
# =============================================================================
resolverd: resolverd.c $(WIRE_SRC) $(SANDBOX_SRC) dns_wire.h sandbox.h | ossl-sanity
	@echo "  CC [PROD]  $@"
	$(CC) $(CSTD) $(WARN) -Wno-misleading-indentation $(PROD_FLAGS) $(VERSION_FLAGS) \
	      $(SECCOMP_CFLAGS) $(INCLUDES) -o $@ $(filter %.c,$^) $(LIBS) $(SECCOMP_LIBS)
	strip --strip-unneeded $@

resolverd_debug: resolverd.c $(WIRE_SRC) $(SANDBOX_SRC) dns_wire.h sandbox.h | ossl-sanity
	@echo "  CC [DEBUG] $@"
	$(CC) $(CSTD) $(WARN) -Wno-misleading-indentation $(DEBUG_FLAGS) $(VERSION_FLAGS) \
	      $(SECCOMP_CFLAGS) $(INCLUDES) -o $@ $(filter %.c,$^) $(LIBS) $(SECCOMP_LIBS)
	@echo ""
	@echo "  Debug binary: $@  (ASan/UBSan enabled — do NOT use in production)"
	@echo "  Run as:  ASAN_OPTIONS=detect_leaks=1 ./$@"

# =============================================================================
# Signing
# =============================================================================

# GPG detached armoured signature
sign: $(BIN)
	@echo "  SIGN [GPG] $(BIN) → $(SIG_GPG)"
	$(GPG_SIGN) --output $(SIG_GPG) $(BIN)
	@echo "  GPG signature written: $(SIG_GPG)"
	@echo ""
	@gpg --batch --verify $(SIG_GPG) $(BIN) && \
	    echo "  ✓ Signature verified OK" || \
	    (echo "  ✗ Signature verification FAILED"; exit 1)

# OpenSSL Ed25519 raw-signature (secondary, non-GPG environments)
sign-openssl: $(BIN) $(OSSL_SIGN_KEY)
	@echo "  SIGN [OSSL] $(BIN) → $(SIG_OSSL)"
	openssl dgst -sha256 -sign $(OSSL_SIGN_KEY) \
	        -out $(SIG_OSSL) $(BIN)
	@echo "  OpenSSL signature written: $(SIG_OSSL)"
	@echo "  Verify with:"
	@echo "    openssl dgst -sha256 -verify $(OSSL_PUBKEY) -signature $(SIG_OSSL) $(BIN)"

# =============================================================================
# Verification
# =============================================================================
verify: $(BIN) $(SIG_GPG)
	@echo "  VERIFY [GPG] $(SIG_GPG)"
	@gpg --batch --verify $(SIG_GPG) $(BIN) && \
	    echo "  ✓  GPG signature is valid" || \
	    (echo "  ✗  GPG signature is INVALID or key not trusted"; exit 1)
	@if [ -f $(SIG_OSSL) ] && [ -f $(OSSL_PUBKEY) ]; then \
	    echo "  VERIFY [OSSL] $(SIG_OSSL)"; \
	    openssl dgst -sha256 -verify $(OSSL_PUBKEY) \
	            -signature $(SIG_OSSL) $(BIN) && \
	        echo "  ✓  OpenSSL signature is valid" || \
	        echo "  ✗  OpenSSL signature is INVALID"; \
	fi

# =============================================================================
# Code-signing key generation (one-time setup)
# =============================================================================
gen-signing-key:
	@mkdir -p keys
	@echo "  GEN  Ed25519 code-signing key pair → keys/codesign.{key,pub}.pem"
	openssl genpkey -algorithm ed25519 -out keys/codesign.key.pem
	openssl pkey -in keys/codesign.key.pem -pubout -out keys/codesign.pub.pem
	@echo ""
	@echo "  Self-signed certificate (for reference / TLSA/DANE use):"
	openssl req -new -x509 -days 3650 \
	        -key keys/codesign.key.pem \
	        -out keys/codesign.crt \
	        -subj "/CN=dns_server-codesign/O=Local/C=US"
	@chmod 600 keys/codesign.key.pem
	@echo ""
	@echo "  ✓  Keys generated. Keep keys/codesign.key.pem secret."
	@echo "     Distribute keys/codesign.pub.pem to verifiers."
	@echo ""
	@echo "  To generate a GPG code-signing key:"
	@echo "    gpg --batch --gen-key <<EOF"
	@echo "    %no-protection"
	@echo "    Key-Type: ed25519"
	@echo "    Key-Usage: sign"
	@echo "    Name-Real: dns_server codesign"
	@echo "    Name-Email: codesign@example.local"
	@echo "    Expire-Date: 2y"
	@echo "    %commit"
	@echo "    EOF"
	@echo "  Then: make prod GPG_KEY=codesign@example.local"

# =============================================================================
# Install
# =============================================================================
install: $(BIN) $(SIG_GPG)
	@echo "  INSTALL $(BIN) → $(BINDIR)/$(BIN)"
	install -d $(BINDIR)
	install -m 0755 $(BIN) $(BINDIR)/$(BIN)
	@echo "  INSTALL $(SIG_GPG) → $(SIGDIR)/$(SIG_GPG)"
	install -d $(SIGDIR)
	install -m 0644 $(SIG_GPG) $(SIGDIR)/$(SIG_GPG)
	@if [ -f $(SIG_OSSL) ]; then \
	    echo "  INSTALL $(SIG_OSSL) → $(SIGDIR)/$(SIG_OSSL)"; \
	    install -m 0644 $(SIG_OSSL) $(SIGDIR)/$(SIG_OSSL); \
	fi
	@echo ""
	@echo "  ✓  Installed. Verify on target with:"
	@echo "     gpg --verify $(SIGDIR)/$(SIG_GPG) $(BINDIR)/$(BIN)"

uninstall:
	@echo "  REMOVE $(BINDIR)/$(BIN)"
	rm -f $(BINDIR)/$(BIN)
	@echo "  REMOVE $(SIGDIR)/$(SIG_GPG) $(SIGDIR)/$(SIG_OSSL)"
	rm -f $(SIGDIR)/$(SIG_GPG) $(SIGDIR)/$(SIG_OSSL)
	@rmdir --ignore-fail-on-non-empty $(SIGDIR) 2>/dev/null || true

